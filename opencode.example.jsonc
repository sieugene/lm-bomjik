{
  "$schema": "https://opencode.ai/config.json",

  // Default model for new sessions (providerID/modelID).
  "model": "llama-local/qwen3.6-35b-a3b",

  "providers": {
    "llama-local": {
      "name": "llama.cpp local",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
        // apiKey is not needed: llama-server runs without auth on localhost.
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6-35B-A3B (local)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  }
}
